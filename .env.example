# Bearer token the Catalog Service requires on every tool endpoint.
# Callers send:  Authorization: Bearer <CATALOG_API_TOKEN>
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Must be at least 24 characters. The service refuses to start without it.
CATALOG_API_TOKEN=replace-me-with-a-generated-token

# Path to the catalogue export. Defaults to data/gift-shop-catalog.csv.
CATALOG_CSV_PATH=data/gift-shop-catalog.csv

# Optional: precomputed one-line pitches for over-long descriptions.
# See scripts/build_pitches.py. Absent is fine - ingest falls back to truncation.
CATALOG_PITCHES_PATH=data/pitches.json

# Optional: precomputed Spanish name + description for the human-facing /p/ page
# only - never sent to the tools, which always pass the English catalogue value.
# Absent is fine - the /p/ page falls back to English. See translation_hash() in
# app/ingest.py for the staleness check.
CATALOG_TRANSLATIONS_ES_PATH=data/translations_es.json

# Port. Cloud Run injects this automatically; only needed locally.
PORT=8080
